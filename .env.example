# Copy to .env and fill in. Never commit the real .env.

# --- Core / security ---
# HMAC signing key for approval tokens. Generate with: openssl rand -hex 32
# If unset, an ephemeral secret is generated at startup (tokens won't survive a restart).
TF_APPROVAL_GATE_SECRET=

# Sandboxed workspace root -- all tf_workspace_init workspaces live under here.
TF_APPROVAL_GATE_WORKDIR=.tf-approval-gate/workspaces
TF_APPROVAL_GATE_STATE_DIR=.tf-approval-gate

# --- Approval mode ---
# "slack" (default, needs the Slack vars below) or "cli" (dev/local only, weaker guarantee).
APPROVAL_MODE=slack
TF_APPROVAL_GATE_APPROVAL_TTL_MS=1800000

# --- Slack (Socket Mode) ---
# Create a Slack app from examples/slack-app-manifest.yml, install it to your workspace.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_APPROVAL_CHANNEL=C0123456789
# Comma-separated Slack user IDs allowed to click Approve/Reject.
SLACK_APPROVER_USER_IDS=U0123456789

# --- Policy ---
# HIGH or CRITICAL -- findings at or above this severity block tf_request_approval.
TF_APPROVAL_GATE_BLOCK_SEVERITY=HIGH
TF_APPROVAL_GATE_ALLOW_POLICY_OVERRIDE=false

# --- Cost (optional) ---
INFRACOST_API_KEY=

# --- Supply-chain allowlists (optional, empty = allow everything) ---
TF_APPROVAL_GATE_ALLOWED_PROVIDERS=hashicorp/aws,hashicorp/random,hashicorp/null
TF_APPROVAL_GATE_ALLOWED_MODULE_SOURCES=

# --- Subprocess limits ---
TF_APPROVAL_GATE_EXEC_TIMEOUT_MS=300000
TF_APPROVAL_GATE_EXEC_MAX_BUFFER=20971520
TF_APPROVAL_GATE_REFRESH_DEBOUNCE_MS=20000

TF_APPROVAL_GATE_DEBUG=
